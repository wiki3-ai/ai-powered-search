{
  "name": "AI-Powered Search (All Services)",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "notebooks",
  "runServices": [
    "notebooks",
    "solr",
    "opensearch",
    "opensearch-dashboards",
    "weaviate",
    "vespa",
    "zookeeper"
  ],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/tmp/notebooks",
  "forwardPorts": [
    7077,
    8082,
    8081,
    4041,
    8888,
    2345,
    8983,
    9200,
    9600,
    5601,
    8090,
    50051,
    8080,
    19071,
    2181
  ],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "openBrowser"
    },
    "2345": {
      "label": "Search Webserver"
    },
    "8983": {
      "label": "Solr Admin"
    },
    "9200": {
      "label": "OpenSearch"
    },
    "5601": {
      "label": "OpenSearch Dashboards"
    },
    "8090": {
      "label": "Weaviate"
    },
    "8080": {
      "label": "Vespa"
    },
    "7077": {
      "label": "Spark Master"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
