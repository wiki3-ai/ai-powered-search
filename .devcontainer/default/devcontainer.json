{
  "name": "AI-Powered Search (Default)",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "notebooks",
  "runServices": [
    "notebooks",
    "solr",
    "zookeeper"
  ],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/tmp/notebooks",
  "forwardPorts": [
    7077,
    8082,
    8081,
    4041,
    8888,
    2345,
    8983,
    2181
  ],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "openBrowser"
    },
    "2345": {
      "label": "Search Webserver"
    },
    "8983": {
      "label": "Solr Admin"
    },
    "7077": {
      "label": "Spark Master"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
